# Public URL of the site (canonical, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# NestJS API (GET /auth/google returns the Google consent URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Sign-in buttons, in order (see src/lib/auth.ts). Ones the API reports as not configured are hidden.
NEXT_PUBLIC_AUTH_PROVIDERS=google,microsoft
