{
  "name": "ai_calendar_assistant",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts",
    "playwright:install": "playwright install chromium --with-deps",
    "clean": "node scripts/clean.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AI Calendar Assistant Monorepo",
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.7.2"
  }
}
