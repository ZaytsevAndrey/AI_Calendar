{
  "name": "luefy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "admin"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:landing\"",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start:dev --workspace=backend",
    "start:admin": "npm run start --workspace=admin",
    "start:admin-api": "npm run start:admin-api --workspace=backend",
    "start:piper": "node tools/piper-http.mjs",
    "voice:eval:dialogue": "npm run voice:eval:dialogue --workspace=backend",
    "start:landing": "npm run dev --prefix landing",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:admin": "npm run build --workspace=admin",
    "build:landing": "npm ci --prefix landing && npm run build --prefix landing",
    "build:site": "npm run build:frontend && npm run build:landing && node scripts/assemble-site.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts",
    "playwright:install": "playwright install chromium --with-deps",
    "clean": "node scripts/clean.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "luefy",
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.7.2"
  }
}
