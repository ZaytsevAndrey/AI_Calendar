JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
APP_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI in Google Cloud Console (callback is handled by the backend)
GOOGLE_REDIRECT_URI=http://localhost:3001/google-calendar/callback
FRONTEND_URL=http://localhost:3000
# Note: TypeORM in app.module.ts uses database: db.sqlite
DATABASE_URL=file:./db.sqlite
