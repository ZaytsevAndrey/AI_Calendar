JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
APP_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI in Google Cloud Console (callback is handled by the backend)
GOOGLE_REDIRECT_URI=http://localhost:3001/google-calendar/callback
FRONTEND_URL=http://localhost:3000
# Microsoft Entra / Outlook (optional — roadmap §27 Wave 3). See documentation/integrations.md
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
# MICROSOFT_TENANT=common
# Apple iCloud Calendar uses per-user CalDAV (Apple ID + app-specific password) in Settings — no server APPLE_* env.
# Local default is SQLite (db.sqlite). For production set a Neon postgres URL, e.g.:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=file:./db.sqlite
# Optional: SQLITE_PATH=db.sqlite
# Optional: TYPEORM_SYNC=false  (keep true for empty Neon on first deploy)
# Optional: DATABASE_SSL=false  (Neon needs SSL; default is on for postgres)
# Free Groq key (https://console.groq.com/keys) — required for voice task creation
GROQ_API_KEY=
# Optional extra Groq orgs (GROQ_API_KEY_2, _3, … any count). Live API rotates on TPM/TPD when 2+ are set.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# Soft per-user chat-token ceiling per civil day (default 100000). Set 0 to disable.
# VOICE_DAILY_TOKEN_LIMIT=100000
# Optional overrides:
# GROQ_STT_MODEL=whisper-large-v3
# (faster/cheaper: whisper-large-v3-turbo — worse on short uk/ru phrases)
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# Companion planner. Free key from https://aistudio.google.com/apikey — no card.
# When set, /voice/turn planning uses this instead of Groq gpt-oss-120b.
# Parse and speech-to-text stay on Groq. Unset keeps the Groq planner.
# GEMINI_API_KEY=
# GEMINI_PLANNER_MODEL=gemini-3.8-flash
# Cheaper planner trial. Key from https://platform.deepseek.com/api_keys
# When DEEPSEEK_API_KEY is set, planning uses it ahead of Qwen and Gemini.
# VOICE_LLM_PROVIDER=deepseek also sends parse there. Unset keeps parse on Groq.
# Groq stays for speech-to-text and for parse when the provider is unset.
# VOICE_LLM_PROVIDER=deepseek
# Thinking is forced off. Off-peak is cheaper; peak is UTC 01:00–04:00 and 06:00–10:00 on weekdays.
# DEEPSEEK_API_KEY=
# DEEPSEEK_PLANNER_MODEL=deepseek-flash
# Cheaper planner trial. International Model Studio key (Singapore price).
# When set, /voice/turn planning uses this instead of Gemini. Parse stays on Groq.
# QWEN_API_KEY=
# QWEN_PLANNER_MODEL=qwen3.7-flash
# Local chat model (Ollama). When set, task parse uses this instead of Groq.
# Optional Azure Speech. Both values are required. The same key transcribes
# and speaks. Free F0: 5 audio hours/month and 0.5 million TTS characters/month.
# Recordings are converted to 16 kHz WAV as-is; silence is not cut.
# Unset keeps Groq Whisper for transcription and Piper or the browser for speech.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=northeurope
# Speech-to-text stays on GROQ_API_KEY when Azure is unset. Create the model with tools/calendar-voice.Modelfile.
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=calendar-voice
# Local Piper TTS. Start with: npm run start:piper
# PIPER_URL=http://127.0.0.1:5510
# Web Push reminders. Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for POST /reminders/tick (header: x-reminder-cron-secret)
REMINDER_CRON_SECRET=
