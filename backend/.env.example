JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
APP_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI in Google Cloud Console (callback is handled by the backend)
GOOGLE_REDIRECT_URI=http://localhost:3001/google-calendar/callback
FRONTEND_URL=http://localhost:3000
# Local default is SQLite (db.sqlite). For production set a Neon postgres URL, e.g.:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=file:./db.sqlite
# Optional: SQLITE_PATH=db.sqlite
# Optional: TYPEORM_SYNC=false  (keep true for empty Neon on first deploy)
# Optional: DATABASE_SSL=false  (Neon needs SSL; default is on for postgres)
# Free Groq key (https://console.groq.com/keys) — required for voice task creation
GROQ_API_KEY=
# Optional extra Groq orgs (GROQ_API_KEY_2, _3, … any count). Live API rotates on TPM/TPD when 2+ are set.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# Soft per-user chat-token ceiling per civil day (default 100000). Set 0 to disable.
# VOICE_DAILY_TOKEN_LIMIT=100000
# Optional overrides:
# GROQ_STT_MODEL=whisper-large-v3
# (faster/cheaper: whisper-large-v3-turbo — worse on short uk/ru phrases)
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# Local chat model (Ollama). When set, task parse uses this instead of Groq.
# Speech-to-text stays on GROQ_API_KEY. Create the model with tools/calendar-voice.Modelfile.
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=calendar-voice
# Local Piper TTS. Start with: npm run start:piper
# PIPER_URL=http://127.0.0.1:5510
# Web Push reminders. Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for POST /reminders/tick (header: x-reminder-cron-secret)
REMINDER_CRON_SECRET=
